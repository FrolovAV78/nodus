{
  "name": "nodus",
  "private": true,
  "version": "0.1.0",
  "description": "Аналитика и explorer для YottaDB",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
